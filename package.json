{
  "name": "devcard",
  "version": "0.1.1",
  "description": "Local-first developer profile README generator with explicit validation and update checklists.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "devcard": "bin/devcard.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx",
    "smoke": "node scripts/smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "audit:dependencies": "npm audit --audit-level=low",
    "release:metadata": "node scripts/release-metadata.mjs",
    "release:preflight": "node scripts/release-metadata.mjs --tag \"$GITHUB_REF_NAME\" --registry",
    "release:check": "npm run release:metadata && npm run audit:dependencies && npm run check && npm test && npm run build && npm run smoke && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "readme",
    "profile",
    "developer-profile",
    "cli",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/devcard.git"
  },
  "homepage": "https://github.com/rogerchappel/devcard#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/devcard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  }
}
